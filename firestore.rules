rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /books/{bookId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /readers/{readerId} {
      allow read, write: if request.auth != null;
    }
    match /loans/{loanId} {
      allow read, write: if request.auth != null;
    }
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
